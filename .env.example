# Django Secret Key (generate a strong random secret key for production)
DJANGO_SECRET_KEY=your-production-django-secret-key-here

# Debug Mode (set to False in production)
DEBUG=False

# Allowed Hosts (comma-separated list of domains/IPs, e.g. api.yourdomain.com,your-app.onrender.com)
ALLOWED_HOSTS=api.yourdomain.com,.onrender.com

# PostgreSQL Database URL (Render / Neon PostgreSQL connection string)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# CORS Allowed Origins (comma-separated list of frontend domains, e.g. https://yourdomain.com,https://www.yourdomain.com)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# CSRF Trusted Origins (comma-separated list of origins)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL Redirect (set to True when using HTTPS in production)
SECURE_SSL_REDIRECT=True

# Frontend Environment Variable (used during Vite build)
VITE_API_URL=https://api.yourdomain.com
