# Django Secret Key
DJANGO_SECRET_KEY=your-production-django-secret-key-here

# Debug Mode
DEBUG=False

# Allowed Hosts
ALLOWED_HOSTS=api.yourdomain.com,.onrender.com

# PostgreSQL Database URL
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend Domain (used for emails and password reset links)
FRONTEND_URL=https://yourdomain.com

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL Redirect
SECURE_SSL_REDIRECT=True

# Cloudinary URL for Media Storage (Required for Render production)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Email Configuration (SMTP for Gmail or others)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
